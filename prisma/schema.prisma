generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DIRECT_URL")
}

model Gym {
  id        String   @id @default(cuid())
  name      String
  timezone  String   @default("America/Chicago")
  createdAt DateTime @default(now())

  // Public-facing info — surfaced via MCP (gym_overview tool) and the
  // athlete dashboard. All optional so older test gyms still work.
  tagline        String?
  mission        String? // Short philosophy paragraph
  about          String? // Longer pitch / description
  hoursJson      Json? // { mon: { open: "07:00", close: "19:00" }, ... }
  locationsJson  Json? // [{ name, city, state, comingSoon? }]
  contactJson    Json? // { email, phone, altEmail? }
  servicesJson   Json? // [{ slug, name, summary }]
  facilitiesText String?

  config            GymConfig?
  trainers          Trainer[]
  athletes          Athlete[]
  sessions          Session[]
  checkIns          CheckIn[]
  walkIns           WalkIn[]
  waiverSignatures  WaiverSignature[]
  draftSchedules    DraftSchedule[]
  bookingRequests   BookingRequest[]
  groups            Group[]
  calendarEvents    CalendarEvent[]
  recoveryVisits    RecoveryVisit[]
  groupJoinRequests GroupJoinRequest[]
}

model GymConfig {
  id                      String   @id @default(cuid())
  gymId                   String   @unique
  gym                     Gym      @relation(fields: [gymId], references: [id], onDelete: Cascade)
  floorCap                Int      @default(2)
  sessionLengthsJson      String   @default("[30,60]")
  bufferMinutes           Int      @default(0)
  allowSameTrainerSameDay Boolean  @default(true)
  cancellationPolicyHours Int      @default(24)
  noShowPolicy            String   @default("flag_only")
  defaultSessionMinutes   Int      @default(60)
  // Recovery room is billed outside the app; this is the default line price
  // used when logging a visit. Cents, so no floating-point money.
  recoveryPriceCents      Int      @default(2500)
  updatedAt               DateTime @updatedAt
}

model User {
  id           String   @id @default(cuid())
  email        String   @unique
  passwordHash String
  name         String
  role         String   @default("TRAINER")
  createdAt    DateTime @default(now())

  trainer Trainer?
}

model Trainer {
  id       String  @id @default(cuid())
  userId   String  @unique
  gymId    String
  archived Boolean @default(false)
  user     User    @relation(fields: [userId], references: [id], onDelete: Cascade)
  gym      Gym     @relation(fields: [gymId], references: [id], onDelete: Cascade)

  // Public bio surfaced via MCP (trainer_bio tool) and dashboard.
  title          String? // "Founder + Trainer", "Physical Therapist & Trainer", etc.
  bio            String? // Full paragraph
  specialties    String[] // ["speed", "return to sport", "adaptive"]
  certifications String[] // ["CSCS", "NASM CPT", ...]
  education      String? // Free-form for degrees / formal education
  photoUrl       String? // Trainer headshot — public URL, rendered on
  // dashboard and returned as base64 image block
  // by the trainer_bio MCP tool.

  athletes        Athlete[]
  sessions        Session[]
  sessionCoaches  SessionCoach[]
  groupCoaches    GroupCoach[]
  availability    TrainerAvailability[]
  exceptions      AvailabilityException[]
  bookingRequests BookingRequest[]

  @@index([gymId])
  @@index([archived])
}

model TrainerAvailability {
  id          String  @id @default(cuid())
  trainerId   String
  trainer     Trainer @relation(fields: [trainerId], references: [id], onDelete: Cascade)
  dayOfWeek   Int
  startMinute Int
  endMinute   Int

  @@index([trainerId, dayOfWeek])
}

model AvailabilityException {
  id          String   @id @default(cuid())
  trainerId   String
  trainer     Trainer  @relation(fields: [trainerId], references: [id], onDelete: Cascade)
  date        DateTime @db.Date
  startMinute Int?
  endMinute   Int?
  isAvailable Boolean
  reason      String?
  /// Exceptions for one day are applied in this order, so a later entry
  /// overrides an earlier one. Without it, an all-day block always beat a
  /// later "actually, he IS free 9-11" and the override silently did nothing.
  createdAt   DateTime @default(now())

  @@index([trainerId, date])
}

model Athlete {
  id           String    @id @default(cuid())
  gymId        String
  firstName    String
  lastName     String
  // NOT unique: one parent email (and phone) covers several kids. The set of
  // athletes sharing a normalized email IS the family — see src/lib/athleteAuth.ts.
  email        String
  phone        String?
  passwordHash String?
  address      String?
  // Stored as a date (no time) — an integer age would silently rot, and
  // age-banded email segments recompute from this.
  birthdate    DateTime? @db.Date
  trainerId    String?
  // SetNull, NOT Cascade: with Cascade, deleting a Trainer row would silently
  // delete every athlete assigned to them. archive_trainer already dodges this
  // by nulling trainerId first, but nothing should depend on that discipline.
  trainer      Trainer?  @relation(fields: [trainerId], references: [id], onDelete: SetNull)
  gym          Gym       @relation(fields: [gymId], references: [id], onDelete: Cascade)

  emailVerified              Boolean   @default(false)
  emailVerificationToken     String?   @unique
  emailVerificationExpiresAt DateTime?
  waiverSignedAt             DateTime?
  archived                   Boolean   @default(false)
  // Promotional only. Reminders and booking confirmations are transactional
  // and ignore this flag; blasts must respect it.
  emailOptOut                Boolean   @default(false)
  // SMS requires explicit opt-in (TCPA), so it defaults to off.
  smsOptIn                   Boolean   @default(false)

  sessions           Session[]
  sessionAttendees   SessionAttendee[]
  checkIns           CheckIn[]
  standingSlots      AthleteStandingSlot[]
  oauthAuthCodes     OAuthAuthorizationCode[]
  oauthAccessTokens  OAuthAccessToken[]
  oauthRefreshTokens OAuthRefreshToken[]
  bookingRequests    BookingRequest[]
  groupMemberships   GroupMember[]
  groupJoinRequests  GroupJoinRequest[]
  recoveryVisits     RecoveryVisit[]
  createdAt          DateTime                 @default(now())

  @@index([gymId])
  @@index([archived])
  @@index([email])
  @@index([phone])
}

model AthleteStandingSlot {
  id          String  @id @default(cuid())
  athleteId   String
  athlete     Athlete @relation(fields: [athleteId], references: [id], onDelete: Cascade)
  trainerId   String?
  dayOfWeek   Int
  startMinute Int
  duration    Int     @default(60)
  active      Boolean @default(true)
  notes       String?

  @@index([athleteId])
}

model Session {
  id                String    @id @default(cuid())
  gymId             String
  trainerId         String
  athleteId         String // primary attendee; group sessions also use SessionAttendee
  scheduledAt       DateTime
  duration          Int       @default(60)
  isRecurring       Boolean   @default(false)
  recurrencePattern String?
  recurrenceEndDate DateTime?
  parentSessionId   String?
  completed         Boolean   @default(false)
  completedAt       DateTime?
  cancelled         Boolean   @default(false)
  notes             String?
  createdAt         DateTime  @default(now())

  // Set when this session came from a Group's recurring schedule.
  groupId String?

  gym             Gym               @relation(fields: [gymId], references: [id], onDelete: Cascade)
  trainer         Trainer           @relation(fields: [trainerId], references: [id])
  athlete         Athlete           @relation(fields: [athleteId], references: [id])
  group           Group?            @relation(fields: [groupId], references: [id], onDelete: SetNull)
  attendees       SessionAttendee[]
  // trainerId stays the lead coach so every existing query keeps working;
  // this is the full roster including that lead.
  coaches         SessionCoach[]
  parentSession   Session?          @relation("RecurringSessions", fields: [parentSessionId], references: [id])
  childSessions   Session[]         @relation("RecurringSessions")
  checkIn         CheckIn?
  bookingRequests BookingRequest[]

  @@index([gymId, scheduledAt])
  @@index([trainerId, scheduledAt])
  @@index([groupId])
}

model SessionAttendee {
  id        String @id @default(cuid())
  sessionId String
  athleteId String

  session Session @relation(fields: [sessionId], references: [id], onDelete: Cascade)
  athlete Athlete @relation(fields: [athleteId], references: [id], onDelete: Cascade)

  createdAt DateTime @default(now())

  @@unique([sessionId, athleteId])
  @@index([athleteId])
}

model CheckIn {
  id          String   @id @default(cuid())
  gymId       String
  athleteId   String
  sessionId   String?  @unique
  checkInTime DateTime @default(now())
  matched     Boolean  @default(false)

  gym     Gym      @relation(fields: [gymId], references: [id], onDelete: Cascade)
  athlete Athlete  @relation(fields: [athleteId], references: [id])
  session Session? @relation(fields: [sessionId], references: [id])

  @@index([gymId])
}

model WalkIn {
  id                   String    @id @default(cuid())
  gymId                String
  name                 String
  email                String?
  checkInTime          DateTime  @default(now())
  claimed              Boolean   @default(false)
  claimedBy            String?
  claimedAt            DateTime?
  convertedToAthleteId String?

  gym Gym @relation(fields: [gymId], references: [id], onDelete: Cascade)

  @@index([gymId])
}

model WaiverSignature {
  id        String   @id @default(cuid())
  gymId     String
  email     String
  legalName String
  signedAt  DateTime @default(now())
  ipAddress String?
  athleteId String?

  gym Gym @relation(fields: [gymId], references: [id], onDelete: Cascade)

  @@index([email])
  @@index([gymId])
}

model DraftSchedule {
  id          String   @id @default(cuid())
  gymId       String
  createdById String?
  status      String   @default("active")
  title       String?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  gym              Gym               @relation(fields: [gymId], references: [id], onDelete: Cascade)
  proposedBookings ProposedBooking[]
  messages         ChatMessage[]

  @@index([gymId, status])
}

// NOTE: attendeeIds/coachIds replace the old trick of stuffing a roster into
// `notes` as "Group of N: id1,id2" and regex-parsing it back at commit time.
model ProposedBooking {
  id                String        @id @default(cuid())
  draftId           String
  draft             DraftSchedule @relation(fields: [draftId], references: [id], onDelete: Cascade)
  action            String
  trainerId         String?
  athleteId         String?
  scheduledAt       DateTime?
  duration          Int           @default(60)
  existingSessionId String?
  notes             String?
  conflictReason    String?
  // Full rosters for group proposals. Empty means a single booking that uses
  // athleteId/trainerId. Bare string arrays, matching how trainerId/athleteId
  // are already stored on this staging table.
  attendeeIds       String[]      @default([])
  coachIds          String[]      @default([])
  groupId           String?
  /// Set when the owner is deliberately recording something that already
  /// happened. Must persist to commit time — the commit re-validates, and
  /// without this a backfilled proposal would pass at propose time and then
  /// be rejected as "in the past" on confirmation.
  allowPast         Boolean       @default(false)
  status            String        @default("pending")
  createdAt         DateTime      @default(now())

  @@index([draftId])
}

model ChatMessage {
  id        String        @id @default(cuid())
  draftId   String
  draft     DraftSchedule @relation(fields: [draftId], references: [id], onDelete: Cascade)
  role      String
  content   String
  toolCalls Json?
  createdAt DateTime      @default(now())

  @@index([draftId, createdAt])
}

// --- OAuth 2.1 + MCP (Phase 2) ---
//
// Athletes connect their personal Claude.ai (or any MCP-capable client)
// to the DSC MCP server. Connection happens via OAuth 2.1 with PKCE,
// using Dynamic Client Registration so the client doesn't need a
// pre-shared client_id.

model OAuthClient {
  id               String   @id @default(cuid())
  // For DCR'd clients, this is auto-generated. For static admin-created
  // ones, can be set manually.
  clientId         String   @unique
  // Public clients (Claude.ai mobile, ChatGPT) use PKCE without a
  // secret. Confidential clients (server-side integrations) have one.
  clientSecretHash String?
  name             String? // optional human-readable name from DCR
  redirectUris     String[] // exact-match list of allowed redirects
  // dynamic = registered via /oauth/register; static = admin-seeded
  source           String   @default("dynamic")
  createdAt        DateTime @default(now())

  authorizationCodes OAuthAuthorizationCode[]
  accessTokens       OAuthAccessToken[]
  refreshTokens      OAuthRefreshToken[]

  @@index([clientId])
}

model OAuthAuthorizationCode {
  id                  String      @id @default(cuid())
  code                String      @unique
  clientId            String
  client              OAuthClient @relation(fields: [clientId], references: [clientId], onDelete: Cascade)
  athleteId           String
  athlete             Athlete     @relation(fields: [athleteId], references: [id], onDelete: Cascade)
  redirectUri         String
  // PKCE: client provides code_challenge during /authorize; supplies
  // the matching code_verifier on /token.
  codeChallenge       String
  codeChallengeMethod String // "S256"
  scope               String      @default("mcp")
  expiresAt           DateTime
  usedAt              DateTime? // single-use; refuse if set
  createdAt           DateTime    @default(now())

  @@index([code])
}

model OAuthAccessToken {
  id         String      @id @default(cuid())
  token      String      @unique
  clientId   String
  client     OAuthClient @relation(fields: [clientId], references: [clientId], onDelete: Cascade)
  athleteId  String
  athlete    Athlete     @relation(fields: [athleteId], references: [id], onDelete: Cascade)
  scope      String      @default("mcp")
  expiresAt  DateTime
  revokedAt  DateTime?
  lastUsedAt DateTime?
  createdAt  DateTime    @default(now())

  @@index([token])
  @@index([athleteId])
}

model OAuthRefreshToken {
  id        String      @id @default(cuid())
  token     String      @unique
  clientId  String
  client    OAuthClient @relation(fields: [clientId], references: [clientId], onDelete: Cascade)
  athleteId String
  athlete   Athlete     @relation(fields: [athleteId], references: [id], onDelete: Cascade)
  expiresAt DateTime
  revokedAt DateTime?
  createdAt DateTime    @default(now())

  @@index([token])
}

// Athlete-initiated booking requests, e.g. via the MCP server.
// Distinct from chat-side ProposedBookings (which are part of a
// DraftSchedule). These need owner action before becoming Sessions.
model BookingRequest {
  id            String    @id @default(cuid())
  gymId         String
  athleteId     String
  trainerId     String
  scheduledAt   DateTime
  duration      Int       @default(60)
  notes         String?
  source        String    @default("mcp") // mcp, web, etc.
  status        String    @default("pending") // pending, approved, declined, cancelled
  declineReason String?
  resolvedAt    DateTime?
  resolvedBy    String? // userId of the staff member who acted
  sessionId     String? // populated when approved
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt

  gym     Gym      @relation(fields: [gymId], references: [id], onDelete: Cascade)
  athlete Athlete  @relation(fields: [athleteId], references: [id], onDelete: Cascade)
  trainer Trainer  @relation(fields: [trainerId], references: [id])
  session Session? @relation(fields: [sessionId], references: [id])

  @@index([gymId, status])
  @@index([athleteId])
  @@index([trainerId])
}

// ---------------------------------------------------------------------------
// Communications
// ---------------------------------------------------------------------------

// Idempotency ledger for anything we send. The row is claimed BEFORE the
// provider is called: if the unique dedupeKey collides we know this message
// already went out (or is going out) and we skip. That biases to at-most-once,
// which is the right trade for reminders — a crashed run loses one reminder,
// it never double-texts an athlete at 6am.
model NotificationLog {
  id        String   @id @default(cuid())
  gymId     String
  dedupeKey String   @unique
  type      String // session_reminder | session_booked | standing_materialized | blast
  channel   String // email | sms
  sessionId String?
  athleteId String?
  trainerId String?
  blastId   String?
  recipient String // email address or E.164 number, for audit
  status    String   @default("pending") // pending | sent | failed | skipped
  detail    String? // skip reason or provider error
  createdAt DateTime @default(now())

  @@index([gymId, type, createdAt])
  @@index([sessionId])
}

// An announcement to a segment of athletes. Drafted first (audience snapshot
// + copy), sent only after an explicit confirmation — the same propose/commit
// shape the scheduler uses, so the AI can never fire one off on its own.
model Blast {
  id             String    @id @default(cuid())
  gymId          String
  createdById    String?
  source         String // admin_ui | ai_chat
  status         String    @default("draft") // draft | sending | sent | failed | discarded
  channel        String    @default("email")
  audienceKind   String // all | group | age_band
  audienceLabel  String
  audienceJson   String // recipients frozen at draft time
  subject        String
  body           String
  recipientCount Int       @default(0)
  sentCount      Int       @default(0)
  failedCount    Int       @default(0)
  sentAt         DateTime?
  createdAt      DateTime  @default(now())

  @@index([gymId, createdAt])
}

// ---------------------------------------------------------------------------
// Groups — named, recurring training cohorts ("the basketball group")
// ---------------------------------------------------------------------------

model Group {
  id          String   @id @default(cuid())
  gymId       String
  gym         Gym      @relation(fields: [gymId], references: [id], onDelete: Cascade)
  name        String
  // Recurrence. Null means an ad-hoc group that exists only as a roster —
  // useful for email blasts without a standing time.
  dayOfWeek   Int?
  startMinute Int?
  duration    Int      @default(60)
  active      Boolean  @default(true)
  notes       String?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  /// Shown to families browsing the schedule. Null hides the group from them
  /// entirely, so a group can exist as a private roster (or a blast audience)
  /// without ever being advertised.
  openForSignup Boolean @default(false)
  /// Max athletes. Null means no limit — the gym's floor cap still applies.
  capacity      Int?
  /// One or two lines for parents: who this group is for.
  description   String?

  members      GroupMember[]
  coaches      GroupCoach[]
  sessions     Session[]
  joinRequests GroupJoinRequest[]

  // Unique per gym so the AI can resolve "the basketball group" by name.
  @@unique([gymId, name])
  @@index([gymId, active])
}

model GroupMember {
  id        String   @id @default(cuid())
  groupId   String
  athleteId String
  group     Group    @relation(fields: [groupId], references: [id], onDelete: Cascade)
  athlete   Athlete  @relation(fields: [athleteId], references: [id], onDelete: Cascade)
  createdAt DateTime @default(now())

  @@unique([groupId, athleteId])
  @@index([athleteId])
}

/// A family asking for a spot in an open group.
///
/// Deliberately NOT a BookingRequest: that model is session-shaped (it needs a
/// trainer, a time and a duration, and approving it mints one Session). Joining
/// a group is a roster change that spans every future occurrence, so it gets
/// its own shape rather than a pile of nullable columns on the other one.
model GroupJoinRequest {
  id            String    @id @default(cuid())
  gymId         String
  groupId       String
  athleteId     String
  status        String    @default("pending") // pending, approved, declined, cancelled
  note          String?
  declineReason String?
  resolvedAt    DateTime?
  resolvedBy    String?
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt

  gym     Gym     @relation(fields: [gymId], references: [id], onDelete: Cascade)
  group   Group   @relation(fields: [groupId], references: [id], onDelete: Cascade)
  athlete Athlete @relation(fields: [athleteId], references: [id], onDelete: Cascade)

  @@index([gymId, status])
  @@index([groupId, status])
  @@index([athleteId])
}

model GroupCoach {
  id        String   @id @default(cuid())
  groupId   String
  trainerId String
  // Exactly one lead per group; becomes Session.trainerId on materialize so
  // every existing single-trainer query keeps working.
  isLead    Boolean  @default(false)
  group     Group    @relation(fields: [groupId], references: [id], onDelete: Cascade)
  trainer   Trainer  @relation(fields: [trainerId], references: [id], onDelete: Cascade)
  createdAt DateTime @default(now())

  @@unique([groupId, trainerId])
  @@index([trainerId])
}

// Multiple coaches on one session. Session.trainerId remains the lead.
model SessionCoach {
  id        String   @id @default(cuid())
  sessionId String
  trainerId String
  session   Session  @relation(fields: [sessionId], references: [id], onDelete: Cascade)
  trainer   Trainer  @relation(fields: [trainerId], references: [id], onDelete: Cascade)
  createdAt DateTime @default(now())

  @@unique([sessionId, trainerId])
  @@index([trainerId])
}

// ---------------------------------------------------------------------------
// Company calendar — staff meetings, not training
// ---------------------------------------------------------------------------

// Deliberately NOT a Session. Session.athleteId is required and read by the
// engine, check-in, the floor cap and the athlete-facing MCP tools; making it
// optional to fit meetings would leak meetings into athlete feeds and force
// null-guards through all of that.
model CalendarEvent {
  id          String   @id @default(cuid())
  gymId       String
  gym         Gym      @relation(fields: [gymId], references: [id], onDelete: Cascade)
  title       String
  description String?
  startsAt    DateTime
  duration    Int      @default(60)
  kind        String   @default("meeting")
  /// Empty means all staff.
  trainerIds  String[] @default([])
  createdBy   String?
  cancelled   Boolean  @default(false)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@index([gymId, startsAt])
}

// ---------------------------------------------------------------------------
// Recovery room — usage log, billed outside the app
// ---------------------------------------------------------------------------

model RecoveryVisit {
  id         String   @id @default(cuid())
  gymId      String
  gym        Gym      @relation(fields: [gymId], references: [id], onDelete: Cascade)
  athleteId  String
  athlete    Athlete  @relation(fields: [athleteId], references: [id], onDelete: Cascade)
  at         DateTime @default(now())
  priceCents Int
  note       String?
  createdBy  String?
  createdAt  DateTime @default(now())

  @@index([gymId, at])
  @@index([athleteId, at])
}

/// Fixed-window rate limiting, backed by the database we already run.
///
/// Serverless functions cannot count in memory — every instance starts at
/// zero — so the counter has to live somewhere shared. Redis is the textbook
/// answer; for a gym's login endpoint one indexed upsert per attempt on Neon
/// is indistinguishable in practice and needs no new vendor. Swap for
/// Upstash if this app ever sees real traffic.
///
/// `key` is "<bucket>:<subject>:<window-start>", e.g.
/// "login:203.0.113.9:2026-08-30T17:05". Rows are pruned opportunistically.
model RateLimit {
  key       String   @id
  count     Int      @default(0)
  expiresAt DateTime

  @@index([expiresAt])
}
